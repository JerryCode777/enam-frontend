<?xml version="1.0" encoding="utf-8"?>
<!-- El build de release borra los recursos que el código Java/Kotlin no nombra.
     El icono de los recordatorios solo se nombra desde Dart (como texto), así
     que sin esto desaparecía: el plugin fallaba con «invalid_icon» y ningún
     recordatorio se programaba en Android (1.1.10 a 1.1.12). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notificacion" />
